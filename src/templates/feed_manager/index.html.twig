{% extends 'base.html.twig' %}

{% block body %}
    <div style="max-width: 1000px; margin: 40px auto; font-family: sans-serif; padding: 0 20px;">
        <h1>📦 Feed Manager Dashboard</h1>

        {# Flash Messages #}
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div style="padding: 12px; margin-bottom: 20px; background: {{ label == 'success' ? '#d4edda' : '#f8d7da' }}; color: {{ label == 'success' ? '#155724' : '#721c24' }}; border-radius: 4px;">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}

        <div style="background: #e3f2fd; border: 1px solid #90caf9; padding: 20px; border-radius: 6px; margin-bottom: 30px; display: flex; justify-content: space-between; align-items: center;">
            <div>
                <h3 style="margin: 0 0 5px 0;">Feed manuell verarbeiten</h3>
                <p style="margin: 0; color: #555;">Aktuelle URL: <code style="background:#fff; padding:2px 4px;">{{ currentUrl|default('Keine URL hinterlegt') }}</code></p>
            </div>
            {# Diesen Button verknüpfen wir gleich im nächsten Schritt #}
            <form action="#" method="POST">
                <button type="submit" style="background: #1e88e5; color: white; border: none; padding: 12px 24px; border-radius: 4px; font-weight: bold; cursor: pointer;">
                    🔄 Jetzt synchronisieren
                </button>
            </form>
        </div>

        <div style="background: #f8f9fa; padding: 20px; border-radius: 6px; margin-bottom: 30px; border: 1px solid #dee2e6;">
            <h3>1. Feed-Einstellungen</h3>
            {{ form_start(configForm) }}
            <div style="display: flex; gap: 10px; align-items: flex-end;">
                <div style="flex: 1;">{{ form_row(configForm.feedUrl, {attr: {style: 'width:100%; padding:8px;'}}) }}</div>
                <button type="submit" style="background: #2e7d32; color:white; border:none; padding:10px 20px; border-radius:4px; height:38px; cursor:pointer;">Speichern</button>
            </div>
            {{ form_end(configForm) }}
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 30px;">

            <div style="border: 1px solid #dee2e6; padding: 20px; border-radius: 6px;">
                <h3>2. Artikel ausschließen (Blacklist)</h3>
                {{ form_start(blacklistForm) }}
                <div style="display: flex; gap: 10px; align-items: flex-end; margin-bottom: 20px;">
                    <div style="flex: 1;">{{ form_row(blacklistForm.sku, {attr: {style: 'width:100%; padding:8px;'}}) }}</div>
                    <button type="submit" style="background:#37474f; color:white; border:none; padding:10px 15px; border-radius:4px; height:38px; cursor:pointer;">+ Sperren</button>
                </div>
                {{ form_end(blacklistForm) }}

                <h4>Gesperrte IDs:</h4>
                <ul style="list-style: none; padding: 0;">
                    {% for item in blacklist %}
                        <li style="padding: 8px 10px; background: #fff; border-bottom: 1px solid #eee; display: flex; justify-content: space-between; align-items: center;">
                            <code>{{ item.sku }}</code>
                            <form action="{{ path('app_feed_delete_blacklist', {id: item.id}) }}" method="POST" onsubmit="return confirm('Sperrung aufheben?');">
                                <button type="submit" style="background:none; border:none; color:#c62828; cursor:pointer; font-weight:bold;">Löschen</button>
                            </form>
                        </li>
                    {% else %}
                        <li style="color: #777; font-style: italic;">Keine Artikel blockiert.</li>
                    {% endfor %}
                </ul>
            </div>

            <div style="border: 1px solid #dee2e6; padding: 20px; border-radius: 6px;">
                <h3>3. Versandkosten-Regeln</h3>
                {{ form_start(shippingForm) }}
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 10px;">
                    <div>{{ form_row(shippingForm.minPrice, {attr: {style: 'width:100%; padding:8px;'}}) }}</div>
                    <div>{{ form_row(shippingForm.shippingCost, {attr: {style: 'width:100%; padding:8px;'}}) }}</div>
                </div>
                <button type="submit" style="background:#37474f; color:white; border:none; padding:10px 15px; border-radius:4px; width:100%; cursor:pointer; margin-bottom: 20px;">+ Regel hinzufügen</button>
                {{ form_end(shippingForm) }}

                <h4>Aktive Regeln:</h4>
                <table style="width: 100%; border-collapse: collapse;">
                    <thead>
                    <tr style="background: #f1f3f4; text-align: left;">
                        <th style="padding: 8px;">Ab Produktpreis</th>
                        <th style="padding: 8px;">Versandkosten</th>
                        <th style="padding: 8px;">Aktion</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for rule in shippingRules %}
                        <tr style="border-bottom: 1px solid #eee;">
                            <td style="padding: 8px;">ab {{ rule.minPrice|number_format(2, ',', '.') }} €</td>
                            <td style="padding: 8px; font-weight: bold;">{{ rule.shippingCost|number_format(2, ',', '.') }} €</td>
                            <td style="padding: 8px;">
                                <form action="{{ path('app_feed_delete_shipping', {id: rule.id}) }}" method="POST">
                                    <button type="submit" style="background:none; border:none; color:#c62828; cursor:pointer;">Entfernen</button>
                                </form>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="3" style="color: #777; font-style: italic; padding: 10px 0;">Keine Regeln definiert (Standard-Feed-Preise gelten).</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>

        </div>
    </div>
{% endblock %}
