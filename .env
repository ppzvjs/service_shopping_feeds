# --- MySQL Konfiguration ---
MYSQL_ROOT_PASSWORD=secret_root_password
MYSQL_DB=symfony_db
MYSQL_USER=symfony_user
MYSQL_PASSWORD=secret_db_password
MYSQL_PORT=3306
MYSQL_HOST=db

# --- Webserver / Ports ---
NGINX_PORT=8080

ORACLE_HOST='COVERIP'
ORACLE_PORT='1521'
ORACLE_SID='COVERSID'
ORACLE_USER='COVERUSER'
ORACLE_PASSWORD='COVERPASSWORD'

# --- Symfony Datenbank-URL (wird im PHP-Container genutzt) ---
DATABASE_URL="mysql://${MYSQL_USER}:${MYSQL_PASSWORD}@${MYSQL_HOST}:3306/${MYSQL_DB}?serverVersion=8.0&charset=utf8mb4"

# --- Symfony Environment ---
APP_ENV=dev
APP_SECRET=secretblabla

DEFAULT_URI="http://localhost:8080"
