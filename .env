# --- MySQL Konfiguration ---
MYSQL_ROOT_PASSWORD=secret_root_password
MYSQL_DB=symfony_db
MYSQL_USER=symfony_user
MYSQL_PASSWORD=secret_db_password
MYSQL_PORT=3306
MYSQL_HOST=db

# --- Webserver / Ports ---
NGINX_PORT=8080

ORACLE_HOST='COVERIP'
ORACLE_PORT='1521'
ORACLE_SID='COVERSID'
ORACLE_USER='COVERUSER'
ORACLE_PASSWORD='COVERPASSWORD'

# --- Symfony Datenbank-URL (wird im PHP-Container genutzt) ---
DATABASE_URL="mysql://${MYSQL_USER}:${MYSQL_PASSWORD}@${MYSQL_HOST}:3306/${MYSQL_DB}?serverVersion=8.0&charset=utf8mb4"

# --- Symfony Environment ---
APP_ENV=dev
APP_SECRET=secretblabla

DEFAULT_URI="http://localhost:${NGINX_PORT}"

# --- Login über Keycloak (OpenID Connect) ---
# Basis-URL des Keycloak-Servers (bei Keycloak < 17 inkl. "/auth"), z.B. https://sso.example.de
KEYCLOAK_URL=
KEYCLOAK_REALM=
KEYCLOAK_CLIENT_ID=
# Leer lassen bei einem "public" Client
KEYCLOAK_CLIENT_SECRET=
# Optional: nur Benutzer mit dieser Realm- oder Client-Rolle dürfen in den Feed-Manager
KEYCLOAK_REQUIRED_ROLE=
# Optional: feste Callback-URL (z.B. hinter einem Proxy), sonst automatisch .../login/keycloak/check
KEYCLOAK_REDIRECT_URI=
# 0 = Login abschalten (nur für lokale Entwicklung!)
KEYCLOAK_ENABLED=1

# --- GTIN/ISBN aus Cover ergänzen (wenn im Quellfeed leer) ---
# Quellen der Reihe nach: TABELLE.SPALTE:VERKNÜPFUNG; leer = Standard (BUAUFL.EAN, BUAUSGAB.EAN, BUAUSGAB.ISBN), 0 = aus
COVER_GTIN_SOURCES=

# Lieferzeit je Artikel aus Cover (C2WART.LIEFER_ZEIT) lesen; 0 = aus (z.B. lokal ohne Cover)
COVER_DELIVERY_TIME=1
